# PostgreSQL — khi chạy `npm run docker:up` (Trackify-Agile/docker), host map :5433 (tránh trùng infra :5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/trackify"

# Nếu chỉ dùng DB từ trackify-agile-infrastructure (postgres-app) cho Prisma FE, sửa URL cho khớp
# user/pass/db trong infrastructure/.env (khác user postgres ở trên).

# NextAuth (thêm khi cài next-auth)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="your-secret-here"

# API Nest (global prefix /api) — backend mặc định cổng 4000 (Next thường 3000).
# Cách A — Trình duyệt gọi thẳng Nest (CORS đã bật trên Nest):
# NEXT_PUBLIC_API_URL="http://localhost:4000/api"
#
# Cách B — Không đặt NEXT_PUBLIC_API_URL: FE dùng relative `/api`, Next proxy sang Nest.
# Đặt origin Nest cho server-side proxy (mặc định http://127.0.0.1:4000 nếu bỏ trống):
# BACKEND_ORIGIN="http://localhost:4000"
#
# Khi NEXT_PUBLIC_API_URL trỏ Next (vd :3000/api), bắt buộc đặt origin file tĩnh Nest — không thì avatar /uploads/... sẽ 404:
# NEXT_PUBLIC_UPLOAD_ORIGIN="http://localhost:4000"
#
# Socket.io cùng origin HTTP với Nest (không thêm /api)
# NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
